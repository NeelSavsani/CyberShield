rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn() && request.auth.token.admin == true; }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId;
      allow read, update, delete: if signedIn() && (request.auth.uid == userId || admin());
      match /analyses/{analysisId} {
        allow read, create, update, delete: if signedIn() && (request.auth.uid == userId || admin());
      }
      match /settings/{settingId} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }
    match /flaggedItems/{itemId} { allow read, write: if admin(); }
    match /systemLogs/{logId} { allow read, write: if admin(); }
    match /flagRequests/{requestId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if admin();
    }
  }
}
