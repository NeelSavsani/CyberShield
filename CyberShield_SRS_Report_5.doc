\pard\sb240\sa140\b\fs32 5 Data Dictionary\b0\fs24\par
\pard\sb240\sa140\b\fs32 5.1 Database Design\b0\fs24\par
\pard\qj\sa120\sl360\slmult1 CyberShield uses a relational design for identities, requests, results, normalized\par
\pard\qj\sa120\sl360\slmult1 indicators, feedback, and audit events. Image bytes are not stored directly in normal\par
\pard\qj\sa120\sl360\slmult1 database rows; protected object storage holds approved assets, while the database\par
\pard\qj\sa120\sl360\slmult1 retains an opaque reference, integrity hash, consent state, and lifecycle status.\par
\pard\qc\b\fs22 Table 6: Core Data Dictionary\b0\fs24\par
\pard\qj\sa120\sl360\slmult1 Entity\par
\pard\qj\sa120\sl360\slmult1 Selected fields\par
\pard\qj\sa120\sl360\slmult1 Purpose\par
\pard\qj\sa120\sl360\slmult1 User\par
\pard\qj\sa120\sl360\slmult1 user_id, role, consent\par
\pard\qj\sa120\sl360\slmult1 Identity and access boundary.\par
\pard\qj\sa120\sl360\slmult1 Analysis Request\par
\pard\qj\sa120\sl360\slmult1 request_id, modality, status\par
\pard\qj\sa120\sl360\slmult1 Tracks one analysis workflow.\par
\pard\qj\sa120\sl360\slmult1 Result\par
\pard\qj\sa120\sl360\slmult1 score, label, version\par
\pard\qj\sa120\sl360\slmult1 Stores an explainable decision.\par
\pard\qj\sa120\sl360\slmult1 Indicator\par
\pard\qj\sa120\sl360\slmult1 type, severity, source\par
